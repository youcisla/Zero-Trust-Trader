# Copy to .env and fill in. Never commit the real file.
#
# The engine reads these from the environment; nothing here is a secret that
# ships with the repo.

# --- MT5 account pin -------------------------------------------------------
# The launcher refuses to scan an account that is not this one. Must contain
# "demo": the pre-flight check refuses anything else.
MT5_EXPECTED_LOGIN=your_demo_login
MT5_SERVER=YourBroker-Demo

# --- Execution consent -----------------------------------------------------
# Unset = dry run. Set only in the shell you are personally using, never in a
# scheduled task or a script an agent can edit.
# ZTT_ALLOW_APPLY=1

# --- Ledger integrity ------------------------------------------------------
# Signs every trial row. Without it the ledger is unsigned and status.py says so.
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
ZTT_LEDGER_KEY=

# --- Scanner tuning --------------------------------------------------------
# Hypotheses per scan are declared by tier 2, not here. These only shape the
# window; changing them does not change the cumulative trial count.
# ZTT_WINDOW_UTC=05:00-17:00
