# Reference only: each component's environment loading is described below.
# Never commit a filled file. The scanner reads this file as a fallback (load_env());
# an exported value wins.
#
# Use the dedicated .venv interpreter. Export the numeric pin in the human's
# PowerShell session or private local launcher, without committing its value.

# --- MT5 account pin -------------------------------------------------------
# PowerShell: $env:MT5_EXPECTED_LOGIN = Read-Host "Numeric demo account login"
# The real server returned by the terminal must also identify a demo account.
# MT5_SERVER is not a scanner configuration variable.

# --- Execution consent -----------------------------------------------------
# Unset = dry run. Set only in the shell you are personally using, never in a
# scheduled task or a script an agent can edit.
# ZTT_ALLOW_APPLY=1

# --- Ledger integrity ------------------------------------------------------
# Signs every trial row. Without it the ledger is unsigned and status.py says so.
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
ZTT_LEDGER_KEY=

# --- Advisory desk ---------------------------------------------------------
# desk.py reads this from env or private .env; never required by a scan.
DEEPSEEK_API_KEY=
# Optional third layer: the decision model (typesafe/jev) answers two typed
# questions per run and is recorded beside the verdict. Absent = the layer says
# "not configured"; it can never gate, size or approve.
OPENROUTER_API_KEY=
# The decision model is on in this tree (desk.toml [decisions] jev_enabled = true).
# ZTT_JEV=0 turns it off; any value here wins over desk.toml. Advisory only: it
# never gates, sizes or approves.
# ZTT_JEV=0

# The run window is the --window-utc argument, not ZTT_WINDOW_UTC.
