stops.json.*.tmp
.stops.*.tmp
tm_run_*.json

# secrets
.env*
!.env.example
config.toml
idempotency.db*
*.local.cmd
.venv/
_publish/

# rust
dashboard/target/
audit.jsonl

# generated per-scan HTML reports
reports/
exports/

# Archify working folders: receipts embed absolute machine paths, the committed
# source of the diagram lives at docs/architecture.archify.json.
.archify/
agent_notes.json
desk_journal.jsonl

# Tool caches and temporary release artifacts.
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
!tools/build_public.py

# The desk's live database is runtime state: it grows every 15 minutes and two
# machines editing it produce a binary conflict every time. It stays local.
desk_history.sqlite
desk_history.sqlite*
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# The published record is a redacted text view: tools/export_desk_history.py.
desk_history.json
!docs/desk-history.jsonl

# Written by run_funnel.progress() every scan; the dashboard reads it live.
scan_progress.json
liquid_universe.backup*.json

# Archify receipts: they record absolute machine paths and file hashes.
# The diagram itself (architecture.html) and its source JSON are tracked.
dashboard/web/architecture.*.json

# tools/batch_backtest.py writes a ranked artifact per run
sweep_*.json
# The monitor's own records: what a human triggered, and that it is alive.
dashboard_scan.jsonl
dashboard_heartbeat.json
dashboard_heartbeat.json.tmp
# A human's stop. Never committed: a frozen tree in a clone is a mystery.
KILL_SWITCH
